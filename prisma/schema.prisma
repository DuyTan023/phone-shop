generator client {
  provider        = "prisma-client"
  output          = "../app/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model brands {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  logo        String?  @db.VarChar(255)
  description String?
  series      series[]
}

model colors {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar(100)
  hex_code         String             @unique @db.VarChar(7)
  description      String?
  product_variants product_variants[]
}

model product_images {
  id               Int               @id @default(autoincrement())
  product_id       Int
  variant_id       Int?
  image_url        String            @db.VarChar(500)
  is_featured      Boolean?          @default(false)
  products         products          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_image_product")
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_image_variant")
}

model product_specs {
  product_id  Int
  spec_key_id Int
  spec_value  String
  unit_id     Int?
  id          Int       @id @default(autoincrement())
  spec_keys   spec_keys @relation(fields: [spec_key_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_spec_key")
  products    products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_spec_product")
  units       units?    @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([product_id, spec_value])
}

model product_variants {
  id             Int              @id @default(autoincrement())
  product_id     Int
  color_id       Int
  storage_id     Int
  ram_id         Int
  sku            String           @unique @db.VarChar(100)
  price          Decimal          @default(0) @db.Decimal(12, 2)
  stock          Int              @default(0)
  cost_price     Decimal          @db.Decimal(12, 0)
  status         Boolean
  is_default     Boolean?
  create_at      DateTime         @db.Date
  update_at      DateTime?        @updatedAt @db.Date
  cart_items     cart_items[]
  order_items    order_items[]
  product_images product_images[]
  colors         colors           @relation(fields: [color_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_variant_color")
  products       products         @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_variant_product")
  rams           rams             @relation(fields: [ram_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_variant_ram")
  storages       storages         @relation(fields: [storage_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_variant_storage")

  @@unique([product_id, storage_id, ram_id, color_id])
}

model products {
  id               Int                @id @default(autoincrement())
  serie_id         Int
  name             String             @db.VarChar(255)
  slug             String             @unique @db.VarChar(255)
  description      String?
  product_images   product_images[]
  product_specs    product_specs[]
  product_variants product_variants[]
  series           series             @relation(fields: [serie_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_serie")

  @@unique([serie_id, name])
}

model rams {
  id               Int                @id @default(autoincrement())
  value            String             @db.VarChar(20)
  product_variants product_variants[]
}

model spec_groups {
  id        Int         @id @default(autoincrement())
  name      String      @db.VarChar(100)
  spec_keys spec_keys[]
}

model spec_keys {
  id            Int             @id @default(autoincrement())
  group_id      Int
  name          String          @db.VarChar(100)
  product_specs product_specs[]
  spec_groups   spec_groups     @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_spec_key_group")
}

model storages {
  id               Int                @id @default(autoincrement())
  value            String             @db.VarChar(20)
  product_variants product_variants[]
}

model series {
  id           Int        @id @default(autoincrement())
  brand_id     Int
  name         String     @db.VarChar(100)
  slug         String     @unique(map: "uq_series_slug") @db.VarChar(120)
  release_year Int?       @db.SmallInt
  products     products[]
  brands       brands     @relation(fields: [brand_id], references: [id], map: "fk_series_brand")

  @@unique([brand_id, name], map: "uq_series_brand_name")
}

model units {
  id            Int             @id @default(autoincrement())
  name          String          @unique @db.VarChar(255)
  symbol        String          @unique @db.VarChar(255)
  product_specs product_specs[]
}

model users {
  id             Int             @id @default(autoincrement())
  clerk_id       String          @unique @db.VarChar(255)
  email          String          @unique @db.VarChar(255)
  full_name      String?         @db.VarChar(255)
  phone          String?         @unique @db.VarChar(20)
  avatar_url     String?
  role           user_role       @default(USER)
  status         user_status     @default(ACTIVE)
  created_at     DateTime        @default(now()) @db.Timestamp(6)
  updated_at     DateTime        @default(now()) @db.Timestamp(6)
  carts          carts?
  orders         orders[]
  user_addresses user_addresses?
}

model communes {
  id             Int              @id @default(autoincrement())
  province_id    Int
  code           String           @unique @db.VarChar(10)
  name           String           @db.VarChar(100)
  full_name      String?          @db.VarChar(150)
  type           commune_type
  created_at     DateTime         @default(now()) @db.Timestamp(6)
  updated_at     DateTime         @default(now()) @db.Timestamp(6)
  provinces      provinces        @relation(fields: [province_id], references: [id], map: "fk_communes_province")
  user_addresses user_addresses[]

  @@unique([id, province_id], map: "uq_communes_id_province")
  @@index([province_id], map: "idx_communes_province_id")
}

model provinces {
  id             Int              @id @default(autoincrement())
  code           String           @unique @db.VarChar(10)
  name           String           @db.VarChar(100)
  full_name      String?          @db.VarChar(150)
  created_at     DateTime         @default(now()) @db.Timestamp(6)
  updated_at     DateTime         @default(now()) @db.Timestamp(6)
  communes       communes[]
  user_addresses user_addresses[]
}

model user_addresses {
  id             Int       @id @default(autoincrement())
  user_id        Int       @unique(map: "uq_user_default_address", where: raw("(is_default = true)"))
  recipient_name String    @db.VarChar(255)
  phone          String    @db.VarChar(20)
  province_id    Int
  commune_id     Int
  address_line   String    @db.VarChar(255)
  note           String?   @db.VarChar(500)
  is_default     Boolean   @default(false)
  created_at     DateTime  @default(now()) @db.Timestamp(6)
  updated_at     DateTime  @default(now()) @db.Timestamp(6)
  communes       communes  @relation(fields: [commune_id, province_id], references: [id, province_id], map: "fk_user_addresses_commune")
  provinces      provinces @relation(fields: [province_id], references: [id], map: "fk_user_addresses_province")
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, map: "fk_user_addresses_user")

  @@index([commune_id], map: "idx_user_addresses_commune_id")
  @@index([province_id], map: "idx_user_addresses_province_id")
  @@index([user_id], map: "idx_user_addresses_user_id")
}

model cart_items {
  id               Int              @id @default(autoincrement())
  cart_id          Int
  variant_id       Int
  quantity         Int              @default(1)
  created_at       DateTime         @default(now()) @db.Timestamp(6)
  updated_at       DateTime         @default(now()) @db.Timestamp(6)
  carts            carts            @relation(fields: [cart_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cart_items_cart")
  product_variants product_variants @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_cart_items_variant")

  @@unique([cart_id, variant_id], map: "uq_cart_items_cart_variant")
  @@index([variant_id], map: "idx_cart_items_variant_id")
}

model carts {
  id         Int          @id @default(autoincrement())
  user_id    Int          @unique
  created_at DateTime     @default(now()) @db.Timestamp(6)
  updated_at DateTime     @default(now()) @db.Timestamp(6)
  cart_items cart_items[]
  users      users        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_carts_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model order_items {
  id               Int              @id @default(autoincrement())
  order_id         Int
  variant_id       Int
  product_name     String           @db.VarChar(255)
  sku              String           @db.VarChar(100)
  variant_info     String           @db.VarChar(255)
  price            Decimal          @db.Decimal(12, 2)
  quantity         Int
  total_price      Decimal          @db.Decimal(12, 2)
  orders           orders           @relation(fields: [order_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_order_items_order")
  product_variants product_variants @relation(fields: [variant_id], references: [id], onUpdate: NoAction, map: "fk_order_items_variant")

  @@index([order_id], map: "idx_order_items_order_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model orders {
  id                 Int            @id @default(autoincrement())
  user_id            Int
  recipient_name     String         @db.VarChar(255)
  recipient_phone    String         @db.VarChar(20)
  shipping_address   String
  note               String?
  subtotal           Decimal        @default(0) @db.Decimal(12, 2)
  shipping_fee       Decimal        @default(0) @db.Decimal(12, 2)
  total_amount       Decimal        @default(0) @db.Decimal(12, 2)
  status             order_status   @default(PENDING)
  payment_method     payment_method @default(COD)
  payment_status     payment_status @default(UNPAID)
  payment_order_code BigInt?        @unique
  payment_link_id    String?        @unique @db.VarChar(100)
  payment_reference  String?        @db.VarChar(100)
  paid_at            DateTime?      @db.Timestamp(6)
  created_at         DateTime       @default(now()) @db.Timestamp(6)
  updated_at         DateTime       @default(now()) @db.Timestamp(6)
  order_items        order_items[]
  users              users          @relation(fields: [user_id], references: [id], onUpdate: NoAction, map: "fk_orders_user")

  @@index([payment_status], map: "idx_orders_payment_status")
  @@index([status], map: "idx_orders_status")
  @@index([user_id], map: "idx_orders_user_id")
}

enum user_role {
  USER
  ADMIN
}

enum user_status {
  ACTIVE
  BLOCKED
}

enum commune_type {
  COMMUNE
  WARD
  SPECIAL_ZONE
}

enum order_status {
  PENDING
  CONFIRMED
  SHIPPING
  COMPLETED
  CANCELLED
}

enum payment_method {
  COD
  PAYOS
}

enum payment_status {
  UNPAID
  PENDING
  PAID
  REFUNDED
}
