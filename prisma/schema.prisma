generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model brands {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  slug        String   @unique @db.VarChar(255)
  logo        String?  @db.VarChar(255)
  description String?
  series      series[]
}

model colors {
  id               Int                @id @default(autoincrement())
  name             String             @db.VarChar(100)
  hex_code         String             @unique @db.VarChar(7)
  description      String?
  product_variants product_variants[]
}

model product_images {
  id               Int               @id @default(autoincrement())
  product_id       Int
  variant_id       Int?
  image_url        String            @db.VarChar(500)
  is_featured      Boolean?          @default(false)
  products         products          @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_image_product")
  product_variants product_variants? @relation(fields: [variant_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_image_variant")
}

model product_specs {
  product_id  Int
  spec_key_id Int
  spec_value  String
  unit_id     Int?
  id          Int       @id @default(autoincrement())
  spec_keys   spec_keys @relation(fields: [spec_key_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_spec_key")
  products    products  @relation(fields: [product_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_spec_product")
  units       units?    @relation(fields: [unit_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([product_id, spec_value])
}

model product_variants {
  id             Int              @id @default(autoincrement())
  product_id     Int
  color_id       Int
  storage_id     Int
  ram_id         Int
  sku            String           @unique @db.VarChar(100)
  price          Decimal          @default(0) @db.Decimal(12, 2)
  stock          Int              @default(0)
  cost_price     Decimal          @db.Decimal(12, 0)
  status         Boolean
  is_default     Boolean?
  create_at      DateTime         @db.Date
  update_at      DateTime?        @updatedAt @db.Date
  product_images product_images[]
  colors         colors           @relation(fields: [color_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_variant_color")
  products       products         @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_variant_product")
  rams           rams             @relation(fields: [ram_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_variant_ram")
  storages       storages         @relation(fields: [storage_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_variant_storage")

  @@unique([product_id, storage_id, ram_id, color_id])
}

model products {
  id               Int                @id @default(autoincrement())
  serie_id         Int
  name             String             @db.VarChar(255)
  slug             String             @unique @db.VarChar(255)
  description      String?
  product_images   product_images[]
  product_specs    product_specs[]
  product_variants product_variants[]
  series           series             @relation(fields: [serie_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_product_serie")

  @@unique([serie_id, name])
}

model rams {
  id               Int                @id @default(autoincrement())
  value            String             @db.VarChar(20)
  product_variants product_variants[]
}

model spec_groups {
  id        Int         @id @default(autoincrement())
  name      String      @db.VarChar(100)
  spec_keys spec_keys[]
}

model spec_keys {
  id            Int             @id @default(autoincrement())
  group_id      Int
  name          String          @db.VarChar(100)
  product_specs product_specs[]
  spec_groups   spec_groups     @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_spec_key_group")
}

model storages {
  id               Int                @id @default(autoincrement())
  value            String             @db.VarChar(20)
  product_variants product_variants[]
}

model series {
  id           Int        @id @default(autoincrement())
  brand_id     Int
  name         String     @db.VarChar(100)
  slug         String     @unique(map: "uq_series_slug") @db.VarChar(120)
  release_year Int?       @db.SmallInt
  products     products[]
  brands       brands     @relation(fields: [brand_id], references: [id], map: "fk_series_brand")

  @@unique([brand_id, name], map: "uq_series_brand_name")
}

model units {
  id            Int             @id @default(autoincrement())
  name          String          @unique @db.VarChar(255)
  symbol        String          @unique @db.VarChar(255)
  product_specs product_specs[]
}

model users {
  id         Int         @id @default(autoincrement())
  clerk_id   String      @unique @db.VarChar(255)
  email      String      @unique @db.VarChar(255)
  full_name  String?     @db.VarChar(255)
  phone      String?     @db.VarChar(20)
  avatar_url String?
  role       user_role   @default(USER)
  status     user_status @default(ACTIVE)
  created_at DateTime    @default(now()) @db.Timestamp(6)
  updated_at DateTime    @default(now()) @db.Timestamp(6)
}

enum user_role {
  USER
  ADMIN
}

enum user_status {
  ACTIVE
  BLOCKED
}
